{
  "version": 2,
  "description": "每条规则只描述事实：这是什么、属于谁、删掉怎么回来、风险级别。规则里不含可执行代码。v2 新增 allowContent：声明该路径下哪些文件类别属于正常成分（docs/photos/media/source/archive/data/keys 默认可疑，命中未声明的类别会把候选降为 P1）。",
  "rules": [
    {
      "id": "npm-cache",
      "name": "npm 全局缓存",
      "category": "包缓存",
      "owner": "npm",
      "tier": "P2",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\npm-cache"],
      "guards": [],
      "allowContent": ["archive", "source"],
      "rebuild": "npm cache clean --force；下次安装自动重建",
      "notes": "纯缓存，不含任何项目代码"
    },
    {
      "id": "pnpm-store",
      "name": "pnpm 存储",
      "category": "包缓存",
      "owner": "pnpm",
      "tier": "P2",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\pnpm\\store"],
      "guards": [],
      "rebuild": "pnpm store prune 或整体删除；下次 install 自动重建",
      "notes": "内容寻址 + 硬链接，需按链接数计算真实释放量"
    },
    {
      "id": "yarn-cache",
      "name": "Yarn 缓存",
      "category": "包缓存",
      "owner": "yarn",
      "tier": "P2",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\Yarn\\Cache"],
      "guards": [],
      "allowContent": ["archive", "source"],
      "rebuild": "yarn cache clean",
      "notes": "纯缓存"
    },
    {
      "id": "pip-cache",
      "name": "pip 缓存",
      "category": "包缓存",
      "owner": "pip",
      "tier": "P2",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\pip\\Cache"],
      "guards": [],
      "allowContent": ["archive"],
      "rebuild": "pip cache purge",
      "notes": "纯缓存"
    },
    {
      "id": "uv-cache",
      "name": "uv 缓存",
      "category": "包缓存",
      "owner": "uv",
      "tier": "P2",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\uv\\cache"],
      "guards": [],
      "allowContent": ["archive"],
      "rebuild": "uv cache prune",
      "notes": "纯缓存"
    },
    {
      "id": "cargo-registry-cache",
      "name": "Cargo 注册表缓存",
      "category": "包缓存",
      "owner": "cargo",
      "tier": "P2",
      "unit": "path",
      "paths": ["%USERPROFILE%\\.cargo\\registry\\cache"],
      "guards": [],
      "allowContent": ["archive"],
      "rebuild": "cargo fetch",
      "notes": "只清 cache，不要动 registry\\src 与 registry\\index"
    },
    {
      "id": "rustup-toolchains",
      "name": "Rust 工具链",
      "category": "运行时",
      "owner": "rustup",
      "tier": "P2",
      "unit": "child",
      "paths": ["%USERPROFILE%\\.rustup\\toolchains"],
      "guards": ["unreferenced"],
      "rebuild": "rustup toolchain install <名称>",
      "notes": "每个子目录是一套完整工具链，旧版本通常可回收"
    },
    {
      "id": "python-installs",
      "name": "Python 解释器",
      "category": "运行时",
      "owner": "python",
      "tier": "P1",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\Programs\\Python\\Python*"],
      "guards": ["unreferenced"],
      "allowContent": ["source"],
      "rebuild": "重新安装对应版本；先用 pip freeze 导出依赖清单",
      "notes": "同一台机器多套解释器很常见，未被 venv 指向的通常是残留"
    },
    {
      "id": "gradle-caches",
      "name": "Gradle 缓存",
      "category": "构建缓存",
      "owner": "gradle",
      "tier": "P1",
      "unit": "path",
      "paths": ["%USERPROFILE%\\.gradle\\caches"],
      "guards": ["manual"],
      "allowContent": ["archive", "source"],
      "rebuild": "Gradle 首次构建重新下载依赖",
      "notes": "先执行 gradle --stop；Android Studio 自带 JBR，不能因为 PATH 里没有 java 就判定为孤儿"
    },
    {
      "id": "maven-repository",
      "name": "Maven 本地仓库",
      "category": "包缓存",
      "owner": "maven",
      "tier": "P2",
      "unit": "path",
      "paths": ["%USERPROFILE%\\.m2\\repository"],
      "guards": [],
      "allowContent": ["archive"],
      "rebuild": "mvn dependency:resolve",
      "notes": "离线环境慎删"
    },
    {
      "id": "nuget-packages",
      "name": "NuGet 包缓存",
      "category": "包缓存",
      "owner": "nuget",
      "tier": "P1",
      "unit": "path",
      "paths": ["%USERPROFILE%\\.nuget\\packages"],
      "guards": ["manual"],
      "allowContent": ["archive"],
      "rebuild": "dotnet restore",
      "notes": "整体清空会导致所有 .NET 项目下次构建变慢；建议只清旧版本"
    },
    {
      "id": "temp-files",
      "name": "用户临时目录",
      "category": "临时残留",
      "owner": "系统",
      "tier": "P2",
      "unit": "child",
      "aggregate": true,
      "paths": ["%LOCALAPPDATA%\\Temp"],
      "guards": [],
      "rebuild": "无需重建，程序下次运行时自行创建",
      "notes": "逐个子项移动；被占用的项会移动失败并记录，不影响其他项"
    },
    {
      "id": "crash-dumps",
      "name": "崩溃转储",
      "category": "日志",
      "owner": "系统",
      "tier": "P2",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\CrashDumps"],
      "guards": [],
      "rebuild": "无需重建",
      "notes": "仅用于排查崩溃，确认不再追踪后可回收"
    },
    {
      "id": "wer-reports",
      "name": "Windows 错误报告",
      "category": "日志",
      "owner": "系统",
      "tier": "P2",
      "unit": "path",
      "paths": ["%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive"],
      "guards": [],
      "allowContent": ["archive", "crash"],
      "rebuild": "无需重建",
      "notes": "诊断数据归档"
    },
    {
      "id": "thumbcache",
      "name": "缩略图缓存",
      "category": "系统缓存",
      "owner": "Explorer",
      "tier": "P2",
      "unit": "path",
      "aggregate": true,
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*.db"],
      "guards": [],
      "allowContent": ["data"],
      "rebuild": "资源管理器自动重建",
      "notes": "需要关闭资源管理器进程后才能移动"
    },
    {
      "id": "huggingface-cache",
      "name": "HuggingFace 模型缓存",
      "category": "模型权重",
      "owner": "huggingface",
      "tier": "P1",
      "unit": "path",
      "paths": ["%USERPROFILE%\\.cache\\huggingface"],
      "guards": ["manual"],
      "rebuild": "按模型重新下载，需要网络与相应访问权限",
      "notes": "体积大且常被多个项目共用；按模型 ID 判断，不要按时间判断"
    },
    {
      "id": "ollama-models",
      "name": "Ollama 模型",
      "category": "模型权重",
      "owner": "ollama",
      "tier": "P1",
      "unit": "path",
      "paths": ["%USERPROFILE%\\.ollama\\models", "%LOCALAPPDATA%\\ollama\\models"],
      "guards": ["manual"],
      "rebuild": "ollama pull <模型>",
      "notes": "blob 是内容寻址共享的，只能按模型删除，不能按文件删除"
    },
    {
      "id": "trae-cache",
      "name": "Trae 渲染与日志缓存",
      "category": "AI 工具缓存",
      "owner": "Trae",
      "tier": "P2",
      "unit": "path",
      "paths": [
        "%APPDATA%\\Trae CN\\Cache",
        "%APPDATA%\\Trae CN\\Code Cache",
        "%APPDATA%\\Trae CN\\GPUCache",
        "%APPDATA%\\Trae CN\\CachedData",
        "%APPDATA%\\Trae CN\\CachedExtensionVSIXs",
        "%APPDATA%\\Trae CN\\DawnGraphiteCache",
        "%APPDATA%\\Trae CN\\DawnWebGPUCache",
        "%APPDATA%\\Trae CN\\Crashpad",
        "%APPDATA%\\Trae CN\\logs"
      ],
      "guards": [],
      "allowContent": ["photos", "source"],
      "rebuild": "启动时自动重建",
      "notes": "只含渲染缓存与日志，不含会话与设置"
    },
    {
      "id": "trae-state",
      "name": "Trae 工作区状态与会话",
      "category": "AI 工具状态",
      "owner": "Trae",
      "tier": "P1",
      "unit": "path",
      "paths": [
        "%APPDATA%\\Trae CN\\User\\workspaceStorage",
        "%APPDATA%\\Trae CN\\User\\globalStorage"
      ],
      "guards": ["manual"],
      "rebuild": "无法重建；需要先备份",
      "notes": "可能含对话历史、索引与撤销记录，删除不可恢复"
    },
    {
      "id": "vscode-cache",
      "name": "VS Code 渲染缓存",
      "category": "编辑器缓存",
      "owner": "VS Code",
      "tier": "P2",
      "unit": "path",
      "paths": [
        "%APPDATA%\\Code\\Cache",
        "%APPDATA%\\Code\\Code Cache",
        "%APPDATA%\\Code\\GPUCache",
        "%APPDATA%\\Code\\CachedData",
        "%APPDATA%\\Code\\logs"
      ],
      "guards": [],
      "allowContent": ["photos", "source"],
      "rebuild": "启动时自动重建",
      "notes": "不含设置、插件与工作区状态"
    },
    {
      "id": "doubao-cache",
      "name": "豆包渲染缓存",
      "category": "AI 工具缓存",
      "owner": "豆包",
      "tier": "P2",
      "unit": "path",
      "paths": [
        "%LOCALAPPDATA%\\Doubao\\User Data\\Default\\Cache",
        "%LOCALAPPDATA%\\Doubao\\User Data\\Default\\Code Cache",
        "%LOCALAPPDATA%\\Doubao\\User Data\\Default\\GPUCache",
        "%LOCALAPPDATA%\\Doubao\\User Data\\Default\\Service Worker\\CacheStorage"
      ],
      "guards": [],
      "allowContent": ["photos", "source"],
      "rebuild": "启动时自动重建",
      "notes": "Chromium 缓存目录；会话数据库不在其中"
    },
    {
      "id": "doubao-app",
      "name": "豆包应用本体",
      "category": "应用安装",
      "owner": "豆包",
      "tier": "P1",
      "unit": "path",
      "paths": ["%LOCALAPPDATA%\\Doubao\\Application"],
      "guards": ["manual"],
      "rebuild": "从官网重新安装",
      "notes": "Electron 类应用常保留多个旧版本；先用占用排序确认再处理"
    },
    {
      "id": "windows-update-cache",
      "name": "Windows 更新缓存",
      "category": "系统缓存",
      "owner": "Windows",
      "tier": "P1",
      "unit": "path",
      "paths": ["%WINDIR%\\SoftwareDistribution\\Download"],
      "guards": ["manual"],
      "allowContent": ["archive"],
      "rebuild": "系统重新下载更新",
      "notes": "建议改用磁盘清理或 DISM，不要直接手删"
    },
    {
      "id": "delivery-optimization",
      "name": "传递优化缓存",
      "category": "系统缓存",
      "owner": "Windows",
      "tier": "P1",
      "unit": "path",
      "paths": ["%WINDIR%\\SoftwareDistribution\\DeliveryOptimization"],
      "guards": ["manual"],
      "rebuild": "系统按需重新缓存",
      "notes": "建议使用 设置 > 存储 > 临时文件"
    }
  ]
}
